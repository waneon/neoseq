{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neoseq CorePort v5",
  "contractVersion": 5,
  "semanticEvents": [
    "CommandDeduplicated",
    "PageEnsured",
    "JournalEnsured",
    "PageRenamed",
    "PageDeleted",
    "PageRestored",
    "TagEnsured",
    "TagRenamed",
    "TagDeleted",
    "TagRestored",
    "PropertiesChanged",
    "TagPropertiesChanged",
    "TagDefaultsChanged",
    "TagAddedAndDefaultsMaterialized",
    "TagRemoved",
    "BlockTextChanged",
    "BlockInserted",
    "BlockSplit",
    "BlockMergedBackward",
    "SubtreeMoved",
    "SubtreesDeleted",
    "GraphSettingsChanged",
    "CommandBatchApplied",
    "LocalUndo",
    "LocalRedo"
  ],
  "queryPlan": {
    "version": 2,
    "limitMax": 1000,
    "anyOfMax": 32,
    "conditionMax": 64,
    "depthMax": 4,
    "sourceProvenance": "# neoseq:query-plan="
  },
  "domainPayloads": {
    "open_graph.response.summary": "GraphSummary",
    "execute.request.command": "CommandEnvelope",
    "execute.response.result": "CommandResult",
    "execute.response.changes": "GraphChanges",
    "read.response.summary": "GraphSummary",
    "read_outline.request.owner": "OutlineOwner",
    "read_outline.response.outline": "OutlineSnapshot"
  },
  "operations": [
    "open_graph",
    "execute",
    "read",
    "read_outline",
    "query",
    "subscribe",
    "close_graph"
  ],
  "errorCodes": [
    "unsupported_contract",
    "invalid_request",
    "page_name_conflict",
    "tag_name_conflict",
    "first_sibling_indent",
    "root_block_outdent",
    "invalid_archive",
    "unsupported_archive",
    "archive_too_large",
    "archive_checksum_mismatch",
    "graph_not_open",
    "graph_already_open",
    "graph_already_exists",
    "wrong_graph",
    "command_timeout",
    "invalid_query",
    "query_budget_exceeded",
    "dirty_unsaved",
    "resync_required",
    "unsupported_schema",
    "storage_busy",
    "storage_full",
    "storage_corrupt",
    "internal"
  ]
}
